{
  "name": "storyboard-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on http://127.0.0.1:1420 && electron . --dev",
    "start": "npm run build && electron .",
    "build": "tsc && vite build",
    "test": "node --test electron/storyboard.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "dictionary-en-us": "^2.2.1",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}
